    "plugin_id": "copy-search",
    "name": "Copy Search",
    "version": "0.1.4",
    "min_herdr_version": "0.7.0",
    "description": "regex and copycat pattern search with extrakto token extraction for pane scrollback, landing in a tmux-style copy mode, copying via OSC 52",
    "manifest_path": "/Users/gchiam/projects/gchiam-dotfiles/stow/herdr/.config/herdr/plugins/github/copy-search-c76f1e25de11/herdr-plugin.toml",
    "plugin_root": "/Users/gchiam/projects/gchiam-dotfiles/stow/herdr/.config/herdr/plugins/github/copy-search-c76f1e25de11",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "build": [
      {
        "command": [
          "cargo",
          "build",
          "--release",
          "--locked"
        ]
      }
    ],
    "actions": [
      {
        "id": "copy",
        "title": "Open copy mode",
        "contexts": [
          "pane"
        ],
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_BIN_PATH\" plugin pane open --plugin copy-search --entrypoint copy"
        ]
      },
      {
        "id": "extract",
        "title": "Extract tokens",
        "contexts": [
          "pane"
        ],
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_BIN_PATH\" plugin pane open --plugin copy-search --entrypoint extract"
        ]
      },
      {
        "id": "search",
        "title": "Search scrollback",
        "contexts": [
          "pane"
        ],
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_BIN_PATH\" plugin pane open --plugin copy-search --entrypoint search"
        ]
      }
    ],
    "panes": [
      {
        "id": "copy",
        "title": "copy mode",
        "placement": "overlay",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-copy-search\" --mode copy"
        ]
      },
      {
        "id": "extract",
        "title": "extract",
        "placement": "overlay",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-copy-search\" --mode extract"
        ]
      },
